<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- AppTfm=net10.0 lets the code be compile-checked on Linux without the Windows packs -->
    <!-- the Windows 10 SDK projection gives the share sheet (DataTransferManager) -->
    <AppTfm Condition="'$(AppTfm)' == ''">net10.0-windows10.0.19041.0</AppTfm>
    <TargetFramework>$(AppTfm)</TargetFramework>
    <EnableWindowsTargeting Condition="$(AppTfm.Contains('windows'))">true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion Condition="$(AppTfm.Contains('windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>ShiftDrop</RootNamespace>
    <AssemblyName>ShiftDrop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\shiftdrop.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun Condition="'$(OS)' == 'Windows_NT'">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- the big projection assembly stays IL only; only a handful of its types are used -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- a small tray app that waits most of the time: keep the heap compact -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShiftDrop.Core\ShiftDrop.Core.csproj" />
    <Content Include="..\..\assets\shiftdrop.ico" Link="shiftdrop.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
